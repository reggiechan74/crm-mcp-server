{
  "name": "crm-mcp-server",
  "version": "0.1.0",
  "description": "CRM contact intelligence MCP server for Claude Code — token-optimized dossier search and management",
  "type": "module",
  "bin": {
    "crm-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "templates/simple/",
    "templates/PROFESSIONAL/",
    "templates/FAMILY/",
    "templates/PERSONAL/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && printf '#!/usr/bin/env node\n' | cat - dist/cli.js > dist/cli.tmp && mv dist/cli.tmp dist/cli.js && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "@xenova/transformers": "^2.17.0",
    "fast-glob": "^3.3.0",
    "yaml": "^2.8.2",
    "zod": "^4.2.1"
  },
  "optionalDependencies": {
    "sqlite-vec-darwin-arm64": "^0.1.7-alpha.2",
    "sqlite-vec-darwin-x64": "^0.1.7-alpha.2",
    "sqlite-vec-linux-x64": "^0.1.7-alpha.2",
    "sqlite-vec-win32-x64": "^0.1.7-alpha.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
